<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FredMahjong.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B3028">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="20,12,20,16"
          RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                <Label Text="JARDIN DE"
                       FontSize="11"
                       CharacterSpacing="3"
                       TextColor="#B6C7A1"
                       FontAttributes="Bold" />
                <Label Text="MAHJONG"
                       FontSize="27"
                       CharacterSpacing="2"
                       TextColor="#FFF1D1"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    WidthRequest="46"
                    HeightRequest="46"
                    Stroke="#547261"
                    StrokeThickness="1"
                    BackgroundColor="#174437"
                    StrokeShape="RoundRectangle 23"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNewGameClicked" />
                </Border.GestureRecognizers>
                <Label Text="↻"
                       FontSize="24"
                       TextColor="#F4D58A"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="16,11"
                Stroke="#456958"
                StrokeThickness="1"
                BackgroundColor="#123B30"
                StrokeShape="RoundRectangle 18">
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="NIVEAU"
                           FontSize="9"
                           CharacterSpacing="2"
                           TextColor="#B6C7A1"
                           FontAttributes="Bold" />
                    <Label Text="01  ·  Le jardin"
                           FontSize="13"
                           TextColor="#FFF1D1"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="End">
                    <Label Text="SCORE"
                           FontSize="9"
                           CharacterSpacing="2"
                           TextColor="#B6C7A1"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End" />
                    <Label x:Name="ScoreLabel"
                           Text="00000"
                           FontSize="13"
                           TextColor="#F4D58A"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End" />
                </VerticalStackLayout>
                <BoxView Grid.Row="1"
                         Grid.ColumnSpan="3"
                         HeightRequest="1"
                         Margin="0,8,0,7"
                         Color="#355A47" />
                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
                    <Label x:Name="StatusLabel"
                           Text="Touchez deux tuiles identiques pour les retirer."
                           FontSize="11"
                           TextColor="#D3DDC7"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="PairsLabel"
                           Grid.Column="1"
                           Text="26 paires"
                           FontSize="11"
                           TextColor="#F4D58A"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Padding="0,4">
            <Border Padding="7"
                    Stroke="#92784B"
                    StrokeThickness="1"
                    BackgroundColor="#174336"
                    StrokeShape="RoundRectangle 20">
                <Grid x:Name="BoardGrid"
                      RowDefinitions="*,*,*,*,*,*"
                      ColumnDefinitions="*,*,*,*,*,*,*,*"
                      Padding="2" />
            </Border>
            <Label Text="✦"
                   FontSize="17"
                   TextColor="#D9BD78"
                   Opacity="0.8"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                   Margin="10,8" />
            <Label Text="✦"
                   FontSize="12"
                   TextColor="#D9BD78"
                   Opacity="0.65"
                   HorizontalOptions="End"
                   VerticalOptions="End"
                   Margin="12,10" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Padding="6,10"
                    BackgroundColor="#174437"
                    Stroke="#456958"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHintClicked" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="✦" FontSize="19" TextColor="#F4D58A" HorizontalTextAlignment="Center" />
                    <Label Text="INDICE" FontSize="9" CharacterSpacing="1.5" TextColor="#E4E8D9" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    Padding="6,10"
                    BackgroundColor="#174437"
                    Stroke="#456958"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShuffleClicked" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="⤨" FontSize="19" TextColor="#F4D58A" HorizontalTextAlignment="Center" />
                    <Label Text="MELANGER" FontSize="9" CharacterSpacing="1.5" TextColor="#E4E8D9" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2"
                    Padding="6,10"
                    BackgroundColor="#174437"
                    Stroke="#456958"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUndoClicked" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="↶" FontSize="19" TextColor="#F4D58A" HorizontalTextAlignment="Center" />
                    <Label Text="ANNULER" FontSize="9" CharacterSpacing="1.5" TextColor="#E4E8D9" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
